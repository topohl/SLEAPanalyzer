
# Exp9 validation study: bulk SLEAP tracking input/output (~4.8 GB) is never
# versioned. Only the scripts, derived tables and figures are kept.
validation/*/sleap_input/
validation/*/sleap_output/
validation/*/sleap_output_all/

# Python bytecode
__pycache__/
*.py[cod]

# Video QC: the manifest and the clip table hold local paths, the review stills are large
validation/exp9_boris/results/video_qc_manifest.csv
validation/exp9_boris/results/video_qc/video_qc_clip.csv
validation/exp9_boris/results/video_qc/stills/
